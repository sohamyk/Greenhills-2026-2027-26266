package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;

@TeleOp(name = "Intake and Launcher Test", group = "Test")
public class IntakeLauncherTest extends LinearOpMode {

    private DcMotor intake;
    private DcMotor launcher;

    private static final double INTAKE_MAX_POWER = 1.0;
    private static final double LAUNCHER_MAX_POWER = 0.8;
    private static final double DEADBAND = 0.05;

    @Override
    public void runOpMode() {
        intake = hardwareMap.get(DcMotor.class, "intake");
        launcher = hardwareMap.get(DcMotor.class, "launcher");

        intake.setPower(0);
        launcher.setPower(0);

        intake.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        launcher.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        intake.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        launcher.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);

        telemetry.addLine("Gamepad 2");
        telemetry.addLine("Left trigger: intake");
        telemetry.addLine("Right trigger: launcher");
        telemetry.addLine("Hold B: stop both");
        telemetry.update();

        waitForStart();

        try {
            while (opModeIsActive()) {
                double intakePower = gamepad2.left_trigger > DEADBAND
                        ? gamepad2.left_trigger * INTAKE_MAX_POWER
                        : 0.0;

                double launcherPower = gamepad2.right_trigger > DEADBAND
                        ? gamepad2.right_trigger * LAUNCHER_MAX_POWER
                        : 0.0;

                if (gamepad2.b) {
                    intakePower = 0;
                    launcherPower = 0;
                }

                intake.setPower(intakePower);
                launcher.setPower(launcherPower);

               

                idle();
            }
        } finally {
            intake.setPower(0);
            launcher.setPower(0);
        }
    }
}
