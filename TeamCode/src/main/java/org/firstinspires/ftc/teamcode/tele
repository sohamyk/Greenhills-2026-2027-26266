//      telemetry.addLine("Down");
//      turretMotorPower = turretMotorPower-0.1;
//      turretmotor.setPower(turretMotorPower);
//    } else{
//      turretmotor.setPower(turretMotorPower);
//    }
//    telemetry.update();

  }





  }
